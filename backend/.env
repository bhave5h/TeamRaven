# ==========================================
# Odin: The Contract War Room Configuration
# ==========================================

# Active LLM Provider: "groq" for dev/testing, "anthropic" for final evaluation
LLM_PROVIDER=groq

# Groq API Configuration (Fast & Free for Dev)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic API Configuration (High Precision for Demo/Eval)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LLM Generation Parameters
LLM_TEMPERATURE=0.0
MAX_TOKENS_PER_CALL=4096

# Multi-Agent Workflow Constraints
MAX_DEBATE_ROUNDS=3
MAX_CLARIFICATION_ROUNDS=2

# Agent Mode: "true" to use fast deterministic mock agents (before real agents are plugged), "false" for live LLM agents
USE_MOCK_AGENTS=true

# Dataset Paths (Supports Judge Bundle Override)
DATA_BUNDLE_PATH=./data/odin_dev_pack/bundle
CLOCK_PATH=./data/odin_dev_pack/clock.json

# SQLite Database Location
DB_PATH=./db/odin.db
